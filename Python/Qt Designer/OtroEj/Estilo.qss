QLabel{

    font-family: Tahoma;
    font-size: 14px;
    font-style: italic;
    font-weight: bold;

}


QPushButton{

    background-color: red;
}

QTextEdit {

    border: 5px dotted green;
    margin: 20px;
    padding: 20px;
    border-radius: 20px;

}

