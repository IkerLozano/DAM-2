#pushButton:hover, #pushButton_2:hover, #pushButton_3:hover{

    background-color: green;
  
}


#pushButton:checked, #pushButton_2:checked, #pushButton_3:checked{

    background-color: red;
  
}


#label_2{

    border: 5px dotted green;
    border-radius: 7px;
    font-family: Tahoma;
    font-size: 20px;
    font-weight: bold;
    color: white;

}

