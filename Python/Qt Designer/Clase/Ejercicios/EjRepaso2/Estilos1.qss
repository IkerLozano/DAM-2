QSlider::handle{
    background-image: url("android.png");
}



QMainWindow{

    background-color: rgb(196, 148, 240);

}



#pushButton{

    background-color: blueviolet;
    border: 3px solid blueviolet;
    border-radius: 7px;
    padding: 7px;

}


#pushButton:hover{

    background-color: rgb(24, 2, 44);
    border: 3px solid rgb(24, 2, 44);
    border-radius: 7px;
    padding: 7px;

}




QLabel{

    font-size: 15px;
    font-weight: bold;
    font-family: Georgia;

}


#comboBox:selected {
    background-color: red;
    color: white;
}
/*
    selected --> Cuando un elemento está seleccionado,
*/

/*
    :hover --> Cuando pasas el ratón por encima 
    :checked --> Cuando está seleccionado, el botón tiene que ser chequeable para que esto funcione 
    :pressed --> Mientras se mantiene pulsado
    ::handle --> sirve para seleccionar la parte móvil de un QSlider 
    :selected --> Cuando un elemento está seleccionado,
    :focus --> Cuando un widget tiene el foco (selecionarlo por ejemplo)


*/