QPushButton{

    background-color: blue;
    color: black;
    text-align: center;
    border: 3px solid blue;
    border-radius: 7px;
    font-weight: bold;
    font-family: Tahoma;
    font-size: 12px;

}

QPushButton:hover{

    background-color: red;
    color: black;
    text-align: center;
    border: 3px solid red;
    border-radius: 7px;
    font-weight: bold;
    font-family: Tahoma;
    font-size: 12px;

}


QPushButton:checked{

    background-color: green;
    color: black;
    text-align: center;
    border: 3px solid green;
    border-radius: 7px;
    font-weight: bold;
    font-family: Tahoma;
    font-size: 12px;

}


#label, #label_2, #label_3{

    font-family: Tahoma;
    font-size: 12px;

}


/*
    SELECCIÓN POR TIPO --> todos los widgets de ese tipo (QPushButton)
    SELECCIÓN POR NOMBRE --> usando el objectName  y un # (tambien se pude idnicar el  tipo de widget y luego el nombre)
    VARIOS SELECCTORES --> # y el objectName y una  coma para separar
*/



