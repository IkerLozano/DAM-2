    <ImageView
        android:id="@+id/imagen"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        android:src="@drawable/perro" />

    <TextView
        android:id="@+id/textoPregunta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:gravity="center"
        android:padding="24dp"
        android:text="@string/que_edad_tienes"
        android:textColor="@color/verde_personalizado"
        android:textSize="24sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/Respuesta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:ems="10"
        android:gravity="center"
        android:hint="@string/introduce_tu_edad"
        android:inputType="number" />

    <Button
        android:id="@+id/botonCalcular"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginVertical="16dp"
        android:backgroundTint="@color/verde_personalizado"
        android:text="@string/calcular"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/textoRespuesta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:gravity="center"
        android:padding="24dp"

        tools:text="@string/si_fueras_un_perro_tendrias_47_a_os"
        android:textColor="@color/verde_personalizado"
        android:textSize="24sp"
        android:textStyle="bold" />

</LinearLayout>