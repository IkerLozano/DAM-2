<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.1</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>org.iesch.ad</groupId>
	<artifactId>demoSpring1</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name/>
	<description/>
	<url/>
	<licenses>
		<license/>
	</licenses>
	<developers>
		<developer/>
	</developers>
	<scm>
		<connection/>
		<developerConnection/>
		<tag/>
		<url/>
	</scm>
	<properties>
		<java.version>21</java.version>
	</properties>


	<!--DEPENDENCIAS-->
	<dependencies>


	<!--
		Permite trabajar con la base de datos usando objetos Java (incluye Hibernate y Spring Data).
        Dónde lo uso: en las entidades (Cliente, Coche...) y en los repositorios
        (PersonaRepositorio, CocheRepositorio) para guardar, buscar y borrar sin escribir SQL.
	-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>


	<!--
		Permite a Java hablar con el servidor de base de datos.
        Dónde lo uso: para conectar con la BD de XAMPP (MariaDB) con los datos de application.properties.
	-->
		<dependency>
			<groupId>com.mysql</groupId>
			<artifactId>mysql-connector-j</artifactId>
			<scope>runtime</scope>
		</dependency>

	<!--
		Qué hace: herramientas para probar repositorios y entidades (JUnit, @DataJpaTest...).
        Dónde lo uso: en la carpeta src/test. No afecta a la app normal.
    -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa-test</artifactId>
			<scope>test</scope>
		</dependency>


	<!--
		Genera código repetitivo automáticamente con anotaciones
        (@Getter, @Setter, @NoArgsConstructor, @AllArgsConstructor, @Data...).
        Dónde lo uso: en las clases del paquete modelo (Cliente, Coche...) para no escribir getters y setters a mano.
    -->
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<optional>true</optional>
		</dependency>


<!--		<dependency>-->
<!--			<groupId>org.springframework.boot</groupId>-->
